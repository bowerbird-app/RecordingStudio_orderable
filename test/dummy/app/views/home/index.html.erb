<% if flash[:notice].present? %>
  <%= render FlatPack::Alert::Component.new(style: :success, title: flash[:notice]) %>
<% end %>

<% if flash[:alert].present? %>
  <%= render FlatPack::Alert::Component.new(style: :danger, title: flash[:alert]) %>
<% end %>

<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Order Demo",
    subtitle: "Recording Studio custom ordering demo powered by RecordingStudio::RecordingStudioOrder snapshots.",
    variant: :h1
  ) %>


  <div class="">
    <div class="flex flex-col gap-6">
      <%= turbo_frame_tag "page_order_demo", class: "flex flex-col gap-6" do %>
        <div>
          <div>
            <% if @folder_recording.present? %>
              <div class="flex flex-col gap-4">
                <div class="flex flex-wrap items-end gap-3">
                  <% if @page_order_recordings.present? %>
                    <%= form_with url: root_path, method: :get,
                                  data: { turbo_frame: "page_order_demo" },
                                  class: "flex flex-1 items-end gap-3" do %>
                      <%= render FlatPack::Select::Component.new(
                        name: "selected_order_recording_id",
                        options: @page_order_recordings.map { |recording|
                          {
                            label: recording.recordable.name.presence || "Untitled list",
                            value: recording.id
                          }
                        },
                        value: @page_order_recording&.id,
                        label: "Ordered List",
                        class: "min-w-72 flex-1",
                        data: {
                          controller: "auto-submit",
                          action: "change->auto-submit#submit"
                        }
                      ) %>
                    <% end %>
                  <% end %>

                  <%= render FlatPack::Button::Component.new(
                    text: "Add new",
                    style: :primary,
                    size: :md,
                    url: recording_studio_orderable.new_recording_order_list_path(
                      parent_recording_id: @folder_recording.id,
                      group_key: :pages,
                      source_order_recording_id: @page_order_recording&.id,
                      redirect_to: root_path
                    )
                  ) %>
                </div>

                <% if @page_order_recordings.blank? %>
                  <%= render FlatPack::Alert::Component.new(
                    style: :info,
                    title: "No ordered list yet",
                    description: capture do %>
                      <%= link_to "Create", recording_studio_orderable.new_recording_order_list_path(
                        parent_recording_id: @folder_recording.id,
                        group_key: :pages,
                        source_order_recording_id: @page_order_recording&.id,
                        redirect_to: root_path
                      ), class: "font-medium underline" %> an ordered list now.
                    <% end
                  ) %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <div>
          <div>
            <% if @folder_recording.present? && @page_order_recording.present? %>
              <div data-controller="order-update-alert page-order-form" data-page-order-form-send-custom-event-value="true" data-action="table:reordered->page-order-form#sync" class="flex flex-col gap-4">
                <%= render FlatPack::Table::Component.new(
                  data: @page_rows,
                  draggable_rows: true,
                  row_id: ->(row) { row.recording.id }
                ) do |table| %>
                  <% table.column(title: "Order", html: ->(row) { row.position.to_s }) %>
                  <% table.column(title: "Page", html: ->(row) { page_order_page_cell(row) }) %>
                  <% table.column(title: "Recording id", html: ->(row) { row.recording.id }) %>
                  <% table.column(title: "Move", html: ->(_row) { page_order_move_buttons }) %>
                <% end %>

                <%= form_with url: demo_folder_page_order_path(@folder_recording), method: :patch,
                              data: { page_order_form_target: "form" },
                              class: "flex flex-wrap items-center gap-3" do |form| %>
                  <%= form.hidden_field :selected_order_recording_id, value: @page_order_recording.id %>
                  <%= form.hidden_field :moving_recording_id, value: "", data: { page_order_form_target: "movingInput" } %>
                  <%= form.hidden_field :target_position, value: "", data: { page_order_form_target: "positionInput" } %>
                  <%= render FlatPack::Badge::Component.new(
                    text: "Changes save after each move",
                    style: :info,
                    size: :sm
                  ) %>
                  <span data-page-order-form-target="status" class="hidden text-sm text-(--surface-muted-content-color)"></span>
                  <span class="text-sm text-(--surface-muted-content-color)">
                    Editing list <strong><%= @page_order.name.presence || "Untitled list" %></strong>
                    on recording <code><%= @page_order_recording.id %></code>
                  </span>
                <% end %>
              </div>
            <% elsif @folder_recording.present? %>
              <%= render FlatPack::Alert::Component.new(
                style: :info,
                title: "Choose or create a named list",
                description: "The draggable table appears when a saved page-order list is selected."
              ) %>
            <% else %>
              <%= render FlatPack::Alert::Component.new(
                style: :warning,
                title: "Demo data missing",
                description: "Run bin/rails db:seed to create the Folder + Page ordering example."
              ) %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    
  </div>
</div>
