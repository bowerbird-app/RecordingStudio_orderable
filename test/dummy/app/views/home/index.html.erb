<% content_for :title, "Order demo" %>
<% content_for :subtitle, "Sibling position for children of an orderable parent. Folder is opted in; Project is not." %>
<% flat_pack_page_nav(round: true, style: :default, anchor_href: main_app.root_path, anchor_tooltip: "Home") %>
<% register_page_nav "Sign out", main_app.destroy_user_session_path, role: :secondary, data: { turbo_method: :delete } %>

<%= render FlatPack::Stack::Component.new(
  gap: :lg,
  data: {
    controller: "order-refresh",
    action: "flat-pack--table-sortable:saved->order-refresh#refresh"
  }
) do %>
  <%= render "home/demo_nav" %>

  <% if @folder_recording %>
    <%= render FlatPack::Cluster::Component.new(justify: :between, align: :start, gap: :md) do %>
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Pages in #{@folder_recording.recordable.name}",
        subtitle: "These pages share one parent, so they can be reordered.",
        spacing: :none
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Reorder in modal",
        style: :secondary,
        data: { modal_id: "reorder-pages-modal" }
      ) %>
    <% end %>

    <div id="order-demo-table">
    <%= render FlatPack::Table::Component.new(data: @ordered_pages) do |table| %>
      <% table.column(
           title: "position",
           html: lambda { |recording|
             (recording.recording_studio_orderable_position || @ordered_pages.index(recording)).to_s
           }
         ) %>
      <% table.column(
           title: "name",
           wrap: :nowrap,
           html: lambda { |recording|
             recording.recordable.respond_to?(:title) ? recording.recordable.title : recording.recordable_type
           }
         ) %>
      <% table.column(title: "type", html: ->(recording) { recording.recordable_type }) %>
      <% table.column(
           title: "action",
           html: lambda { |recording|
             index = @ordered_pages.index(recording)
             actions = []

             if index&.positive?
               actions << form_with(
                 url: main_app.move_page_path(recording),
                 method: :patch,
                 data: { turbo: false }
               ) do
                 safe_join([
                   hidden_field_tag(:to_index, index - 1),
                   render(FlatPack::Button::Component.new(text: "Move up", style: :secondary, type: "submit"))
                 ])
               end
             end

             if index && index < @ordered_pages.length - 1
               actions << form_with(
                 url: main_app.move_page_path(recording),
                 method: :patch,
                 data: { turbo: false }
               ) do
                 safe_join([
                   hidden_field_tag(:to_index, index + 1),
                   render(FlatPack::Button::Component.new(text: "Move down", style: :secondary, type: "submit"))
                 ])
               end
             end

             render(FlatPack::Cluster::Component.new(gap: :sm)) { safe_join(actions) }
           }
         ) %>
    <% end %>
    </div>

    <%= render FlatPack::Modal::Component.new(id: "reorder-pages-modal", title: "Reorder pages", size: :lg) do |modal| %>
      <% modal.body do %>
        <%= render FlatPack::Stack::Component.new(gap: :lg) do %>
          <%= render FlatPack::Text::Component.new(text: "Drag a page into place.") %>
          <%= render FlatPack::Table::Component.new(
            data: @ordered_pages,
            draggable_rows: true,
            min_width: :none,
            reorder_url: reorder_pages_path,
            reorder_resource: "pages",
            row_id: ->(recording) { recording.id }
          ) do |table| %>
            <% table.column(
                 title: "Reorder",
                 width: :fit,
                 wrap: :nowrap,
                 align: :center,
                 html: lambda { |_recording|
                   render(FlatPack::Button::Component.new(
                     icon: "bars-3",
                     icon_only: true,
                     text: "Drag to reorder",
                     style: :secondary,
                     size: :sm,
                     type: "button"
                   ))
                 }
               ) %>
            <% table.column(
                 title: "position",
                 html: lambda { |recording|
                   (recording.recording_studio_orderable_position || @ordered_pages.index(recording)).to_s
                 }
               ) %>
            <% table.column(
                 title: "name",
                 wrap: :nowrap,
                 html: lambda { |recording|
                   recording.recordable.respond_to?(:title) ? recording.recordable.title : recording.recordable_type
                 }
               ) %>
          <% end %>
        <% end %>
      <% end %>
      <% modal.footer do %>
        <%= render FlatPack::Button::Component.new(
          text: "Close",
          style: :secondary,
          data: { action: "click->flat-pack--modal#close" }
        ) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::Alert::Component.new(
      description: "Seed the dummy app to load an orderable folder and its pages.",
      style: :info
    ) %>
  <% end %>

  <% if @unordered_project_recording %>
    <%= render FlatPack::Stack::Component.new(gap: :lg) do %>
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Project is not orderable",
        subtitle: "Installing the gem does not enable order on every type.",
        spacing: :none
      ) %>

      <%= render FlatPack::Card::Component.new(background: :default) do |card| %>
        <% card.body do %>
          <%= render FlatPack::Stack::Component.new(gap: :md) do %>
            <%= render FlatPack::Text::Component.new(
              text: "#{@unordered_project_recording.recordable.name} has not opted in. Only Folder did, for this demo."
            ) %>
            <%= render FlatPack::CodeBlock::Component.new(
              code: "include RecordingStudio::Capabilities::Orderable.to",
              language: "ruby",
              title: "Opt in",
              separated: false
            ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
