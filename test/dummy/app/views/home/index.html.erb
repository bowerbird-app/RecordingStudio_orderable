<% if flash[:notice].present? %>
  <%= render FlatPack::Alert::Component.new(style: :success, title: flash[:notice]) %>
<% end %>

<% if flash[:alert].present? %>
  <%= render FlatPack::Alert::Component.new(style: :danger, title: flash[:alert]) %>
<% end %>

<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Order Demo",
    subtitle: "Recording Studio custom ordering demo powered by RecordingStudio::RecordingStudioOrder snapshots.",
    variant: :h1
  ) %>


  <div class="">
    <div class="flex flex-col gap-6">
      <div>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Your named lists",
          subtitle: "Each list is owner-scoped to the signed-in user and points at the same folder pages.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>

        <div>
          <% if @folder_recording.present? %>
            <div class="flex flex-col gap-4">
              <div class="flex flex-wrap items-end gap-3">
                <%= form_with url: root_path, method: :get, local: true, class: "flex flex-1 items-end gap-3" do %>
                  <%= render FlatPack::Select::Component.new(
                    name: "selected_order_recording_id",
                    options: @page_order_recordings.map { |recording|
                      {
                        label: recording.recordable.name.presence || "Untitled list",
                        value: recording.id
                      }
                    },
                    value: @page_order_recording&.id,
                    label: "Ordered List",
                    placeholder: "Choose a saved list",
                    class: "min-w-72",
                    onchange: "this.form.submit()"
                  ) %>
                <% end %>

                <%= render FlatPack::Button::Component.new(
                  text: "Add new",
                  style: :primary,
                  size: :md,
                  url: recording_studio_orderable.new_recording_order_list_path(
                    parent_recording_id: @folder_recording.id,
                    group_key: :pages,
                    source_order_recording_id: @page_order_recording&.id,
                    redirect_to: root_path
                  )
                ) %>
              </div>

              <% if @list_rows.present? %>
                <div class="grid gap-4 lg:grid-cols-2">
                  <% @list_rows.each do |list_row| %>
                    <div class="rounded-lg border border-(--surface-border-color) p-4 <%= list_row.selected ? 'bg-(--surface-muted-background-color)' : 'bg-(--surface-background-color)' %>">
                      <div class="flex items-start justify-between gap-3">
                        <div>
                          <p class="text-sm font-semibold"><%= list_row.order.name.presence || "Untitled list" %></p>
                          <p class="text-xs text-(--surface-muted-content-color)">
                            Recording <code><%= list_row.recording.id %></code>
                          </p>
                        </div>
                        <% if list_row.selected %>
                          <%= render FlatPack::Badge::Component.new(text: "Selected", style: :success, size: :sm) %>
                        <% else %>
                          <%= link_to root_path(selected_order_recording_id: list_row.recording.id) do %>
                            <%= render FlatPack::Button::Component.new(
                              text: "Open",
                              style: :secondary,
                              size: :sm
                            ) %>
                          <% end %>
                        <% end %>
                      </div>

                      <ol class="mt-3 list-decimal pl-5 text-sm leading-6">
                        <% list_row.ordered_pages.each do |page_recording| %>
                          <li><%= page_recording.recordable.title %></li>
                        <% end %>
                      </ol>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <%= render FlatPack::Alert::Component.new(
                  style: :info,
                  title: "No ordered list yet",
                  description: capture do %>
                    <%= link_to "Create", recording_studio_orderable.new_recording_order_list_path(
                      parent_recording_id: @folder_recording.id,
                      group_key: :pages,
                      source_order_recording_id: @page_order_recording&.id,
                      redirect_to: root_path
                    ), class: "font-medium underline" %> an ordered list now.
                  <% end
                ) %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    
  </div>
</div>
