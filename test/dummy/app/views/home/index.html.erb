<% recording_studio_page_nav(
  title: "Order demo",
  page_nav_anchor_url: main_app.root_path,
  page_nav_anchor_label: "Home"
) %>

<% recording_studio_page_nav_right do %>
  <%= render FlatPack::Button::Component.new(
    text: "Sign out",
    style: :ghost,
    url: main_app.destroy_user_session_path,
    data: { turbo_method: :delete }
  ) %>
<% end %>

<div class="flex flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Order demo",
    subtitle: "Sibling position for children of an orderable parent. Folder is opted in; Project is not.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-3">
    <% demo_nav_links.each do |link| %>
      <%= render FlatPack::Button::Component.new(
        text: link.fetch(:text),
        style: :secondary,
        url: link.fetch(:url)
      ) %>
    <% end %>
  </div>

  <% if @folder_recording %>
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Pages in #{@folder_recording.recordable.name}",
      subtitle: "These siblings share a parent that included RecordingStudio::Capabilities::Orderable.to."
    ) %>

    <%= render FlatPack::Table::Component.new(data: @ordered_pages) do |table| %>
      <% table.column(
           title: "position",
           html: ->(recording) { recording.recording_studio_orderable_position }
         ) %>
      <% table.column(
           title: "name",
           html: lambda { |recording|
             recording.recordable.respond_to?(:title) ? recording.recordable.title : recording.recordable_type
           }
         ) %>
      <% table.column(title: "type", html: ->(recording) { recording.recordable_type }) %>
      <% table.column(
           title: "action",
           html: lambda { |recording|
             index = @ordered_pages.index(recording)
             actions = []

             if index&.positive?
               actions << form_with(
                 url: main_app.move_page_path(recording),
                 method: :patch,
                 data: { turbo: false },
                 html: { class: "shrink-0" }
               ) do
                 safe_join([
                   hidden_field_tag(:to_index, index - 1),
                   render(FlatPack::Button::Component.new(text: "Move up", style: :secondary, type: "submit"))
                 ])
               end
             end

             if index && index < @ordered_pages.length - 1
               actions << form_with(
                 url: main_app.move_page_path(recording),
                 method: :patch,
                 data: { turbo: false },
                 html: { class: "shrink-0" }
               ) do
                 safe_join([
                   hidden_field_tag(:to_index, index + 1),
                   render(FlatPack::Button::Component.new(text: "Move down", style: :secondary, type: "submit"))
                 ])
               end
             end

             content_tag(:div, safe_join(actions), class: "flex flex-wrap items-center gap-2")
           }
         ) %>
    <% end %>
  <% else %>
    <%= render FlatPack::Alert::Component.new(
      description: "Seed the dummy app to load an orderable folder and its pages.",
      style: :info
    ) %>
  <% end %>

  <% if @unordered_project_recording %>
    <section class="flex flex-col gap-4">
      <%= render FlatPack::SectionTitle::Component.new(
        title: "Project is not orderable",
        subtitle: "Installing the gem does not enable order on every recordable."
      ) %>

      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.body do %>
          <p>
            <%= @unordered_project_recording.recordable.name %>
            has not included
            <code>RecordingStudio::Capabilities::Orderable.to</code>.
            Only Folder opted in for this demo.
          </p>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
