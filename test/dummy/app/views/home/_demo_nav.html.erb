<%= render FlatPack::Cluster::Component.new(gap: :md) do %>
  <% demo_nav_links.each do |link| %>
    <%= render FlatPack::Button::Component.new(
      text: link.fetch(:text),
      style: :secondary,
      href: link.fetch(:href),
      current: current_page?(link.fetch(:href))
    ) %>
  <% end %>
<% end %>
