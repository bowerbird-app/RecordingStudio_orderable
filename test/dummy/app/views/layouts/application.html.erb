<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Orderable Demo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Orderable Demo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= render "layouts/flat_pack_stylesheets" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-(--surface-page-background-color) text-(--surface-content-color)" data-theme="rounded">
    <%= render "layouts/icon_sprite" %>

    <div class="h-screen overflow-y-auto overscroll-y-contain">
      <main class="mx-auto flex min-h-full w-full max-w-6xl items-center justify-center p-6 sm:p-10">
        <div class="w-full">
          <% flash.each do |type, message| %>
            <% next if message.blank? %>

            <% style = type.to_sym == :notice ? :success : :danger %>
            <%= render FlatPack::Alert::Component.new(description: message, style: style, class: "mb-6") %>
          <% end %>

          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
