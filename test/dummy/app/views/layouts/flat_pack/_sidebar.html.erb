<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: "Orderable",
      subtitle: "Recording Studio"
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 h-full flex flex-col" aria-label="Main navigation">
      <div class="space-y-1">
        <%= render FlatPack::Sidebar::Item::Component.new(
          label: "Home",
          href: "/",
          icon: :home
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          label: "Drag & Drop: Custom Event",
          href: main_app.root_path(demo: "custom_event"),
          icon: :arrows_up_down
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          label: "Drag & Drop: Flash Message",
          href: main_app.root_path(demo: "flash_message"),
          icon: :bell_alert
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          label: "Setup",
          href: main_app.docs_setup_path,
          icon: :wrench_screwdriver
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          label: "Config",
          href: main_app.docs_config_path,
          icon: :cog_6_tooth
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          label: "Methods",
          href: main_app.docs_methods_path,
          icon: :code_bracket
        ) %>

        <%= render FlatPack::Sidebar::Item::Component.new(
          label: "Views",
          href: main_app.docs_views_path,
          icon: :rectangle_stack
        ) %>
      </div>
      <div class="h-px bg-[var(--sidebar-divider-color)] mx-4 my-2"></div>
      <div class="">
        <p class="text-xs font-semibold uppercase tracking-wider text-[var(--sidebar-item-text-color)] opacity-50 truncate block pl-4">Mounted Paths</p>

        <%= render FlatPack::Sidebar::Item::Component.new(
          label: "Recording Studio Orders",
          href: recording_studio_orderable.recording_studio_orders_path,
          icon: :rectangle_stack
        ) %>
      </div>
    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new(class: "text-sm text-[var(--surface-muted-content-color)]") do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Sign out",
        href: main_app.destroy_user_session_path,
        icon: :arrow_right_on_rectangle,
        class: "mx-0",
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
