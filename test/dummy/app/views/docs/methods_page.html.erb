<div class="mx-auto flex w-full max-w-5xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_href: "javascript:window.history.back()",
    show_home: true,
    home_url: root_path,
    class: "mb-2"
  ) do |breadcrumb| %>
    <% breadcrumb.item(text: "Dummy app docs") %>
    <% breadcrumb.item(text: "Methods") %>
  <% end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Public host-app methods grouped by where you call them.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render FlatPack::Badge::Component.new(text: "Groups define allowed child types", style: :info, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Owner scope is optional", style: :warning, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Mutations persist new snapshots", style: :success, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Core-backed wrappers are labeled", style: :default, size: :sm) %>
  </div>

  <% render_options_table = lambda do |rows|
       render FlatPack::Table::Component.new(data: rows, class: "mt-4") do |table|
         table.column(title: "Variable", html: ->(row) { row[:variable] })
         table.column(title: "Accepts", html: ->(row) { row[:accepts] })
         table.column(title: "Example", html: ->(row) { row[:example] })
         table.column(title: "Why", html: ->(row) { row[:why] || "" })
       end
     end %>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "OrderableRecordable",
      subtitle: "Parent recordable opt-in and convenience helpers.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_studio_order_group",
      subtitle: "Addon API: class macro that declares a named order group and the recordable types it accepts.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "group key", accepts: "Symbol", example: "recording_studio_order_group :pages" },
      { variable: "allows", accepts: "Array<Class>", example: "allows: [Page, Section]" }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">class Folder &lt; ApplicationRecord
  include RecordingStudioOrderable::OrderableRecordable

  recording_studio_order_group :pages, allows: [Page]
  recording_studio_order_group :sections, allows: [Section]
end
# => { "pages" => { group_key: "pages", allows: ["Page"] }, "sections" => { group_key: "sections", allows: ["Section"] } }</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_orders",
      subtitle: "Addon wrapper: reads order snapshots from the parent's child recordings and returns RecordingStudioOrder models.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "owner", accepts: "Actor object or nil", example: "owner: current_user" },
      { variable: "group", accepts: "Symbol or String", example: "group: :pages / group: \"Page\"" },
      {
        variable: "orderable_name",
        accepts: "String",
        example: "orderable_name: \"Primary list\"",
        why: "Target one specific named list by exact name."
      },
      {
        variable: "named_only",
        accepts: "true, false",
        example: "named_only: true",
        why: "Exclude the default unnamed order and return only explicitly named lists."
      }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder.recording_orders(owner: current_user)
# => [#&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;, ...]

folder.recording_orders(owner: current_user, group: "Page")
# => [#&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;]

folder.recording_orders(owner: current_user, group: :pages, orderable_name: "Primary list")
# => [#&lt;RecordingStudio::RecordingStudioOrder name: "Primary list"&gt;]

folder.recording_orders(owner: current_user, group: :pages, named_only: true)
# => [#&lt;RecordingStudio::RecordingStudioOrder name: "Primary list"&gt;, ...]</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "default_recording_order",
      subtitle: "Addon wrapper: finds the default unnamed order for the group and owner scope (not UUID-specific named-list lookup).",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "group_key", accepts: "Symbol or String", example: "default_recording_order(:pages, ...)" },
      { variable: "owner", accepts: "Actor object or nil", example: "owner: current_user" }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder.default_recording_order(:pages, owner: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt; or nil</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "find_recording_order_by_id",
      subtitle: "Addon wrapper: finds one RecordingStudioOrder by order recording UUID and raises ActiveRecord::RecordNotFound when missing.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "order_recording_id", accepts: "String UUID", example: "find_recording_order_by_id(\"order-recording-uuid\", ...)" },
      {
        variable: "group_key",
        accepts: "Symbol or String (optional guardrail)",
        example: "group_key: :pages",
        why: "Constrain lookup to one configured group when needed."
      },
      {
        variable: "owner",
        accepts: "Actor object or nil (optional guardrail)",
        example: "owner: current_user",
        why: "Constrain lookup to one owner scope when needed."
      }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder.find_recording_order_by_id("order-recording-uuid", group_key: :pages, owner: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;

folder.find_recording_order_by_id("missing-order-recording", group_key: :pages, owner: current_user)
# => raises ActiveRecord::RecordNotFound</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "find_or_create_recording_order!",
      subtitle: "Addon orchestration: finds existing order, otherwise creates one using RecordingStudio::Recording#record.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "group_key", accepts: "Symbol or String", example: ":pages" },
      { variable: "owner", accepts: "Actor object or nil", example: "owner: current_user" },
      { variable: "actor", accepts: "Actor object", example: "actor: current_user" },
      { variable: "metadata", accepts: "Hash", example: "metadata: { source: \"ui\" }" }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder.find_or_create_recording_order!(
  :pages,
  owner: current_user,
  actor: current_user,
  metadata: { source: "ui" }
)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "children_for_order_group and ordered_children_for",
      subtitle: "children_for_order_group and ordered_children_for both return arrays (possibly empty); ordered_children_for applies addon explicit ordering.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "group_key", accepts: "Symbol or String", example: "children_for_order_group(:pages)" },
      { variable: "owner", accepts: "Actor object or nil", example: "ordered_children_for(:pages, owner: current_user)" }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder.children_for_order_group(:pages)
# => [#&lt;RecordingStudio::Recording id: "page-1"&gt;, ...]

folder.ordered_children_for(:pages, owner: current_user)
# => [#&lt;RecordingStudio::Recording id: "page-2"&gt;, #&lt;RecordingStudio::Recording id: "page-1"&gt;, ...]</code></pre>
      </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Recording extensions",
      subtitle: "APIs added to RecordingStudio::Recording.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_order_recordings",
      subtitle: "Addon wrapper: returns Recording snapshot rows for order records.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "group_key", accepts: "Symbol or String", example: "recording_order_recordings(:pages, ...)" },
      { variable: "owner", accepts: "Actor object or nil", example: "owner: current_user" },
      {
        variable: "named_only",
        accepts: "true, false",
        example: "named_only: true",
        why: "Use when listing selectable custom orders; hides the default unnamed order record."
      },
      {
        variable: "orderable_name",
        accepts: "String or nil",
        example: "orderable_name: \"Primary list\"",
        why: "Fetch recordings for one named order only."
      }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording.recording_order_recordings(:pages, owner: current_user)
# => [#&lt;RecordingStudio::Recording id: "default-order-recording"&gt;]

folder_recording.recording_order_recordings(:pages, owner: current_user, named_only: true)
# => [#&lt;RecordingStudio::Recording id: "named-order-recording"&gt;, ...]

folder_recording.recording_order_recordings(:pages, owner: current_user, orderable_name: "Primary list")
# => [#&lt;RecordingStudio::Recording id: "primary-list-recording"&gt;]</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_orders",
      subtitle: "Addon wrapper: maps matching snapshot recordings to RecordingStudioOrder models.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "owner", accepts: "Actor object or nil", example: "owner: current_user" },
      { variable: "group", accepts: "Symbol or String", example: "group: :pages / group: \"Page\"" },
      {
        variable: "orderable_name",
        accepts: "String",
        example: "orderable_name: \"Primary list\"",
        why: "Limit the result set to one named list."
      },
      {
        variable: "named_only",
        accepts: "true, false",
        example: "named_only: true",
        why: "Return named lists only; skip the default unnamed order."
      }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording.recording_orders(owner: current_user)
# => [#&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;, ...]

folder_recording.recording_orders(owner: current_user, group: "Page")
# => [#&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;]

folder_recording.recording_orders(owner: current_user, group: :pages, orderable_name: "Primary list")
# => [#&lt;RecordingStudio::RecordingStudioOrder name: "Primary list"&gt;]

folder_recording.recording_orders(owner: current_user, group: :pages, named_only: true)
# => [#&lt;RecordingStudio::RecordingStudioOrder name: "Primary list"&gt;, ...]</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "default_recording_order",
      subtitle: "Addon wrapper: finds the default unnamed RecordingStudioOrder for the group and owner scope (not UUID-specific named-list lookup).",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "group_key", accepts: "Symbol or String", example: "default_recording_order(:pages, ...)" },
      { variable: "owner", accepts: "Actor object or nil", example: "owner: current_user" }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording.default_recording_order(:pages, owner: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt; or nil</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "find_recording_order_by_id",
      subtitle: "Addon wrapper: resolves one RecordingStudioOrder model by order recording UUID with optional group/owner guardrails.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "order_recording_id", accepts: "String UUID", example: "find_recording_order_by_id(\"order-recording-uuid\", ...)" },
      {
        variable: "group_key",
        accepts: "Symbol or String (optional guardrail)",
        example: "group_key: :pages",
        why: "Limit lookup to one order group when needed."
      },
      {
        variable: "owner",
        accepts: "Actor object or nil (optional guardrail)",
        example: "owner: current_user",
        why: "Limit lookup to one owner scope when needed."
      }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording.find_recording_order_by_id("order-recording-uuid", group_key: :pages, owner: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;

folder_recording.find_recording_order_by_id("missing-order-recording", group_key: :pages, owner: current_user)
# => raises ActiveRecord::RecordNotFound</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_order_recording_for",
      subtitle: "Addon wrapper: fetches the underlying Recording snapshot row (or nil) rather than the order model wrapper.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "group_key", accepts: "Symbol or String", example: "recording_order_recording_for(:pages, ...)" },
      { variable: "owner", accepts: "Actor object or nil", example: "owner: current_user" }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording.recording_order_recording_for(:pages, owner: current_user)
# => #&lt;RecordingStudio::Recording id: "default-order-recording"&gt; or nil</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "find_or_create_recording_order! and ordered_children_for",
      subtitle: "Addon APIs: find_or_create_recording_order! returns an order model; ordered_children_for returns an ordered array (possibly empty).",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "group_key", accepts: "Symbol or String", example: "find_or_create_recording_order!(:pages, ...)" },
      { variable: "owner", accepts: "Actor object or nil", example: "owner: current_user" }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording.find_or_create_recording_order!(:pages, owner: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;

folder_recording.ordered_children_for(:pages, owner: current_user)
# => [#&lt;RecordingStudio::Recording id: "page-2"&gt;, #&lt;RecordingStudio::Recording id: "page-1"&gt;, ...]</code></pre>
      </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "RecordingOrder mutations",
      subtitle: "Explicit order snapshot helpers.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::PageTitle::Component.new(
      title: "include_child! and remove_child!",
      subtitle: "Addon mutation API: appends or removes one child id, then persists via RecordingStudio::Recording#revise.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "child recording", accepts: "RecordingStudio::Recording", example: "include_child!(page_three_recording, ...)" },
      { variable: "actor", accepts: "Actor object", example: "actor: current_user" },
      { variable: "metadata", accepts: "Hash", example: "metadata: { source: \"seed\" }" }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">page_order.include_child!(page_three_recording, actor: current_user, metadata: { source: "seed" })
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;

page_order.remove_child!(page_archived_recording, actor: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "move_before! and move_after!",
      subtitle: "Addon mutation API: relative moves with snapshot persistence.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "moving", accepts: "RecordingStudio::Recording", example: "moving: page_three_recording" },
      { variable: "before/after", accepts: "RecordingStudio::Recording", example: "before: page_one_recording" },
      { variable: "actor", accepts: "Actor object", example: "actor: current_user" }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">page_order.move_before!(moving: page_three_recording, before: page_one_recording, actor: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;

page_order.move_after!(moving: page_one_recording, after: page_two_recording, actor: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "move_to_start!, move_to_end!, and move_to_position!",
      subtitle: "Addon mutation API: absolute placement helpers that write a new order snapshot.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "moving", accepts: "RecordingStudio::Recording", example: "moving: page_two_recording" },
      { variable: "position", accepts: "Integer", example: "position: 1" },
      { variable: "actor", accepts: "Actor object", example: "actor: current_user" }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">page_order.move_to_start!(moving: page_two_recording, actor: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;

page_order.move_to_end!(moving: page_one_recording, actor: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;

page_order.move_to_position!(moving: page_three_recording, position: 1, actor: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "reorder! and cleanup_missing_children!",
      subtitle: "Addon mutation API: full replace or cleanup of ordered ids, then persist a revised snapshot.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render_options_table.call([
      { variable: "ordered_recording_ids", accepts: "Array<String>", example: "ordered_recording_ids: [page_two_recording.id, ...]" },
      { variable: "actor", accepts: "Actor object", example: "actor: current_user" },
      { variable: "metadata", accepts: "Hash", example: "metadata: { source: \"bulk_edit\" }" }
    ]) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">page_order.reorder!(
  ordered_recording_ids: [page_two_recording.id, page_one_recording.id],
  actor: current_user,
  metadata: { source: "bulk_edit" }
)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;

page_order.cleanup_missing_children!(actor: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;</code></pre>
        <p class="mt-3 text-xs leading-5 text-(--flatpack-color-muted)">
          Note: trash, access, and device session helpers are provided by RecordingStudio addon gems, not core.
        </p>
      </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Lookup example",
      subtitle: "Resolve the current order from a parent recording or recordable.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render_options_table.call([
      { variable: "folder_recording", accepts: "RecordingStudio::Recording", example: "folder.current_recording" },
      { variable: "group key", accepts: "Symbol", example: ":pages" },
      { variable: "owner", accepts: "Actor object", example: "owner: current_user" }
    ]) %>

    <div>
      <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
        <div class="px-4 py-2 border-b border-(--code-block-border-color) text-sm font-medium text-(--code-block-title-color)">Code Example</div>
        <div class="p-4">
          <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording = folder.current_recording
# => #&lt;RecordingStudio::Recording id: "folder-recording-uuid"&gt;

page_order = folder_recording.find_or_create_recording_order!(:pages, owner: current_user)
# => #&lt;RecordingStudio::RecordingStudioOrder id: "..."&gt;

folder_recording.ordered_children_for(:pages, owner: current_user)
# => [#&lt;RecordingStudio::Recording id: "page-2"&gt;, #&lt;RecordingStudio::Recording id: "page-1"&gt;, ...]</code></pre>
        </div>
      </div>
