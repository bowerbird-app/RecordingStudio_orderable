<div class="mx-auto flex w-full max-w-5xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_href: "javascript:window.history.back()",
    show_home: true,
    home_url: root_path,
    class: "mb-2"
  ) do |breadcrumb| %>
    <% breadcrumb.item(text: "Dummy app docs") %>
    <% breadcrumb.item(text: "Methods") %>
  <% end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Public host-app methods grouped by where you call them.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render FlatPack::Badge::Component.new(text: "Groups define allowed child types", style: :info, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Owner scope is optional", style: :warning, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Mutations persist new snapshots", style: :success, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Core-backed wrappers are labeled", style: :default, size: :sm) %>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "OrderableRecordable",
      subtitle: "Parent recordable opt-in and convenience helpers.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_studio_order_group",
      subtitle: "Addon API: class macro that declares a named order group and the recordable types it accepts.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">class Folder &lt; ApplicationRecord
  include RecordingStudioOrderable::OrderableRecordable

  recording_studio_order_group :pages, allows: [Page]
  recording_studio_order_group :sections, allows: [Section]
end</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_orders and named_recording_orders",
      subtitle: "Addon wrapper: reads order snapshots from the parent's child recordings and returns RecordingStudioOrder models.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder.recording_orders(owner: current_user)
folder.named_recording_orders(:pages, owner: current_user)</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_order_for and named_recording_order_for",
      subtitle: "Addon wrapper: resolves one scoped order model from matching snapshot recordings.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder.recording_order_for(:pages, owner: current_user)
folder.named_recording_order_for("order-recording-uuid", :pages, owner: current_user)</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "find_or_create_recording_order!",
      subtitle: "Addon orchestration: finds existing order, otherwise creates one using RecordingStudio::Recording#record.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder.find_or_create_recording_order!(
  :pages,
  owner: current_user,
  actor: current_user,
  metadata: { source: "ui" }
)</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "children_for_order_group and ordered_children_for",
      subtitle: "children_for_order_group is a core-backed convenience filter; ordered_children_for is addon-specific explicit ordering.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder.children_for_order_group(:pages)
folder.ordered_children_for(:pages, owner: current_user)</code></pre>
      </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Recording extensions",
      subtitle: "APIs added to RecordingStudio::Recording.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_order_recordings and named_recording_order_recordings",
      subtitle: "Addon wrapper: returns Recording snapshot rows for order records.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording.recording_order_recordings(:pages, owner: current_user)
folder_recording.named_recording_order_recordings(:pages, owner: current_user)</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_orders and named_recording_orders",
      subtitle: "Addon wrapper: maps matching snapshot recordings to RecordingStudioOrder models.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording.recording_orders(owner: current_user)
folder_recording.named_recording_orders(:pages, owner: current_user)</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_order_for and named_recording_order_for",
      subtitle: "Addon wrapper: resolves one scoped RecordingStudioOrder model.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording.recording_order_for(:pages, owner: current_user)
folder_recording.named_recording_order_for("order-recording-uuid", :pages, owner: current_user)</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_order_recording_for and named_recording_order_recording_for",
      subtitle: "Addon wrapper: fetches the underlying Recording snapshot row rather than the order model wrapper.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording.recording_order_recording_for(:pages, owner: current_user)
folder_recording.named_recording_order_recording_for("order-recording-uuid", :pages, owner: current_user)</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "find_or_create_recording_order! and ordered_children_for",
      subtitle: "Addon APIs: create path is core-backed by record snapshots, and ordered_children_for applies addon explicit order ids.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording.find_or_create_recording_order!(:pages, owner: current_user)
folder_recording.ordered_children_for(:pages, owner: current_user)</code></pre>
      </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "RecordingOrder mutations",
      subtitle: "Explicit order snapshot helpers.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::PageTitle::Component.new(
      title: "include_child! and remove_child!",
      subtitle: "Addon mutation API: appends or removes one child id, then persists via RecordingStudio::Recording#revise.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">page_order.include_child!(page_three_recording, actor: current_user, metadata: { source: "seed" })
page_order.remove_child!(page_archived_recording, actor: current_user)</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "move_before! and move_after!",
      subtitle: "Addon mutation API: relative moves with snapshot persistence.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">page_order.move_before!(moving: page_three_recording, before: page_one_recording, actor: current_user)
page_order.move_after!(moving: page_one_recording, after: page_two_recording, actor: current_user)</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "move_to_start!, move_to_end!, and move_to_position!",
      subtitle: "Addon mutation API: absolute placement helpers that write a new order snapshot.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">page_order.move_to_start!(moving: page_two_recording, actor: current_user)
page_order.move_to_end!(moving: page_one_recording, actor: current_user)
page_order.move_to_position!(moving: page_three_recording, position: 1, actor: current_user)</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "reorder! and cleanup_missing_children!",
      subtitle: "Addon mutation API: full replace or cleanup of ordered ids, then persist a revised snapshot.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">page_order.reorder!(
  ordered_recording_ids: [page_two_recording.id, page_one_recording.id],
  actor: current_user,
  metadata: { source: "bulk_edit" }
)

page_order.cleanup_missing_children!(actor: current_user)</code></pre>
        <p class="mt-3 text-xs leading-5 text-(--flatpack-color-muted)">
          Note: trash, access, and device session helpers are provided by RecordingStudio addon gems, not core.
        </p>
      </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Lookup example",
      subtitle: "Resolve the current order from a parent recording or recordable.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <div>
      <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
        <div class="px-4 py-2 border-b border-(--code-block-border-color) text-sm font-medium text-(--code-block-title-color)">Code Example</div>
        <div class="p-4">
          <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">folder_recording = folder.current_recording
page_order = folder_recording.find_or_create_recording_order!(:pages, owner: current_user)

folder_recording.ordered_children_for(:pages, owner: current_user)</code></pre>
        </div>
      </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Mutation example",
      subtitle: "Persist the next explicit order snapshot after a move.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <div>
      <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
        <div class="px-4 py-2 border-b border-(--code-block-border-color) text-sm font-medium text-(--code-block-title-color)">Code Example</div>
        <div class="p-4">
          <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">page_order.move_after!(
  moving: page_two_recording,
  after: page_one_recording,
  actor: current_user,
  metadata: { source: "drag_drop" }
)</code></pre>
        </div>
      </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Core vs addon",
      subtitle: "RecordingStudio provides snapshot primitives; this addon adds explicit order semantics on top.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <div>
      <ul class="space-y-3 text-sm leading-6">
        <li>Core RecordingStudio handles recording snapshots and revisions.</li>
        <li>This addon adds group-scoped ordered ids and mutation helpers for explicit list ordering.</li>
        <li>Wrapper methods in this page are convenience APIs around those core snapshot and query primitives.</li>
      </ul>
    </div>
  </div>
</div>