<div class="mx-auto flex w-full max-w-5xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_href: "javascript:window.history.back()",
    show_home: true,
    home_url: root_path,
    class: "mb-2"
  ) do |breadcrumb| %>
    <% breadcrumb.item(text: "Dummy app docs") %>
    <% breadcrumb.item(text: "Config") %>
  <% end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "Configuration hooks exposed by the addon and how the dummy host wires them.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render FlatPack::Badge::Component.new(text: "Default event logging: off", style: :info, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Owner resolution: Recording Studio actor", style: :warning, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Authentication: host-controlled", style: :success, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Parent authorization: required for list UI", style: :warning, size: :sm) %>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Configuration keys",
      subtitle: "Hooks are host-owned; owner resolution can delegate to Recording Studio actor config.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "log_order_events",
          subtitle: "Enables or disables addon semantic order event logging. When enabled, runtime order actions emit prefixed event names into the Recording Studio event stream; when disabled, those addon-specific events are skipped.",
          variant: :h4,
          class: "mb-0 pb-0 mt-8"
        ) %>
        <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
          <div class="p-4">
            <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)"># Controls whether addon-specific semantic order events are logged. Default is false.
  RecordingStudioOrderable.configure do |config|
    config.log_order_events = true
  end</code></pre>
          </div>
        </div>

        <%= render FlatPack::PageTitle::Component.new(
          title: "event_action_prefix",
          subtitle: "Defines the action-name prefix used by addon semantic events. The engine combines this prefix with operation-specific suffixes so downstream logs and analytics can group order activity under a stable namespace.",
          variant: :h4,
          class: "mb-0 pb-0 mt-8"
        ) %>
        <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
          <div class="p-4">
            <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)"># Sets the action name prefix used for semantic order events. Default is "recording_order".
  RecordingStudioOrderable.configure do |config|
    config.event_action_prefix = "recording_order"
  end</code></pre>
          </div>
        </div>

        <%= render FlatPack::PageTitle::Component.new(
          title: "authenticate_controller",
          subtitle: "Optional override for request authentication. If unset, Orderable requires a present actor from RecordingStudio.configuration.actor before mounted actions proceed.",
          variant: :h4,
          class: "mb-0 pb-0 mt-8"
        ) %>
        <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
          <div class="p-4">
            <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)"># Optional override. You can omit this key if RecordingStudio.configuration.actor is already wired.
  RecordingStudioOrderable.configure do |config|
    config.authenticate_controller = -&gt;(controller) do
      controller.authenticate_user! if controller.respond_to?(:authenticate_user!, true)
    end
  end</code></pre>
          </div>
        </div>

        <%= render FlatPack::PageTitle::Component.new(
          title: "current_owner_resolver",
          subtitle: "Optional override for owner scope used by default and named orders. If unset, Orderable falls back to RecordingStudio.configuration.actor, which typically resolves to Current.actor.",
          variant: :h4,
          class: "mb-0 pb-0 mt-8"
        ) %>
        <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
          <div class="p-4">
            <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)"># Optional override. You can omit this key to use RecordingStudio.configuration.actor by default.
  RecordingStudioOrderable.configure do |config|
    config.current_owner_resolver = -&gt;(_controller) do
      RecordingStudio.configuration.actor&amp;.call
    end
  end</code></pre>
          </div>
        </div>

        <%= render FlatPack::PageTitle::Component.new(
          title: "authorize_parent_recording",
          subtitle: "Applies host authorization to the resolved parent recording before list access. The engine passes both controller and parent recording into this lambda and proceeds only when the return value is truthy.",
          variant: :h4,
          class: "mb-0 pb-0 mt-8"
        ) %>
        <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
          <div class="p-4">
            <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)"># Receives the resolved parent recording and should return truthy only when the current owner can access that order context.
  RecordingStudioOrderable.configure do |config|
    config.authorize_parent_recording = -&gt;(controller, parent_recording) do
      controller.send(:current_user).present? &amp;&amp; parent_recording.present?
    end
  end</code></pre>
          </div>
        </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "When to configure",
      subtitle: "Recommended initializer responsibilities.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <div>
      <ul class="space-y-3 text-sm leading-6">
        <li>`authenticate_controller` is optional when your app already sets `RecordingStudio.configuration.actor` reliably for each request.</li>
        <li>Set parent-authorization hooks in the generated initializer so mounted UI requests stay inside host app rules.</li>
        <li>`current_owner_resolver` is optional unless you need owner resolution different from `RecordingStudio.configuration.actor`.</li>
        <li>Keep Recording Studio actor wiring in one place via <code>RecordingStudio.configure { |config| config.actor = -&gt; { Current.actor } }</code>.</li>
        <li>Authorizing the resolved parent recording is required before mounted list pages can read, render, or create lists.</li>
        <li>Turn on event logging only if your Recording Studio event stream needs addon-specific audit entries.</li>
        <li>Keep the prefix stable once downstream reporting depends on those action names.</li>
      </ul>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Initializer example",
      subtitle: "Typical host app configuration for mounted UI access and Recording Studio actor ownership.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <div>
      <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
        <div class="px-4 py-2 border-b border-(--code-block-border-color) text-sm font-medium text-(--code-block-title-color)">Code Example</div>
        <div class="p-4">
          <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">RecordingStudioOrderable.configure do |config|
  config.authenticate_controller = -&gt;(controller) do
    controller.authenticate_user! if controller.respond_to?(:authenticate_user!, true)
  end

  config.current_owner_resolver = -&gt;(_controller) do
    RecordingStudio.configuration.actor&amp;.call
  end

  config.authorize_parent_recording = -&gt;(controller, parent_recording) do
    controller.send(:current_user).present? &amp;&amp; parent_recording.present?
  end

  config.log_order_events = false
  config.event_action_prefix = "recording_order"
end</code></pre>
        </div>
      </div>
    </div>
  </div>
</div>