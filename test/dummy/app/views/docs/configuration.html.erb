<div class="mx-auto flex w-full max-w-5xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_href: "javascript:window.history.back()",
    show_home: true,
    home_url: root_path,
    class: "mb-2"
  ) do |breadcrumb| %>
    <% breadcrumb.item(text: "Dummy app docs") %>
    <% breadcrumb.item(text: "Config") %>
  <% end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Config",
    subtitle: "Configuration hooks exposed by the addon and how the host app controls mounted access and order snapshot behavior.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render FlatPack::Badge::Component.new(text: "Default event logging: off", style: :info, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Actor source: RecordingStudio.configuration.actor", style: :warning, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Authorization: RecordingStudioAccessible", style: :success, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "Create guard: controller + manager", style: :warning, size: :sm) %>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Configuration keys",
      subtitle: "Supported addon keys for event behavior. Authorization is handled by RecordingStudio and RecordingStudioAccessible.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::PageTitle::Component.new(
      title: "recording_studio_order_group",
      subtitle: "Host configuration macro that declares a named order group and the recordable types it accepts.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <%= render FlatPack::Table::Component.new(
      data: [
        { variable: "group key", accepts: "Symbol", example: "recording_studio_order_group :pages" },
        { variable: "allows", accepts: "Array<Class>", example: "allows: [Page, Section]" }
      ],
      class: "mt-4"
    ) do |table| %>
      <% table.column(title: "Variable", html: ->(row) { row[:variable] }) %>
      <% table.column(title: "Accepts", html: ->(row) { row[:accepts] }) %>
      <% table.column(title: "Example", html: ->(row) { row[:example] }) %>
    <% end %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">class Folder &lt; ApplicationRecord
  include RecordingStudioOrderable::OrderableRecordable

  recording_studio_order_group :pages, allows: [Page]
  recording_studio_order_group :sections, allows: [Section]
end
# => { "pages" => { group_key: "pages", allows: ["Page"] }, "sections" => { group_key: "sections", allows: ["Section"] } }</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "log_order_events",
      subtitle: "Enables addon semantic events for order mutations. Disabled by default.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)"># Default is false (quiet by default).
RecordingStudioOrderable.configure do |config|
  config.log_order_events = true
end</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "event_action_prefix",
      subtitle: "Prefix for addon semantic event action names. Keep this stable once reporting depends on it.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)"># Default is "recording_order".
RecordingStudioOrderable.configure do |config|
  config.event_action_prefix = "recording_order"
end</code></pre>
      </div>
    </div>

    <%= render FlatPack::PageTitle::Component.new(
      title: "Authorization flow",
      subtitle: "Mounted pages resolve an actor from Recording Studio and then authorize parent recordings through RecordingStudioAccessible.",
      variant: :h4,
      class: "mb-0 pb-0 mt-8"
    ) %>
    <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
      <div class="p-4">
        <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)"># Parent access contract used by mounted reads and writes:
RecordingStudioAccessible.authorized?(
  actor: RecordingStudio.configuration.actor&amp;.call,
  recording: parent_recording,
  role: :admin
)

# Creation paths enforce this check in both controller and manager layers.</code></pre>
      </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "When to configure",
      subtitle: "Initializer responsibilities for current engine behavior.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <div>
      <ul class="space-y-3 text-sm leading-6">
        <li>Mounted UI authentication is actor-first via <code>RecordingStudio.configuration.actor</code>.</li>
        <li>Mounted reads and writes require <code>RecordingStudioAccessible.authorized?(actor:, recording:, role: :admin)</code>.</li>
        <li>Order creation paths enforce the same parent authorization at both controller and manager levels.</li>
        <li>Legacy authorization hook configuration has been removed and is ignored if still present in initializer files.</li>
        <li>Invalid configuration now raises a boot-time error, so treat initializer values as part of app startup correctness.</li>
        <li>Order changes persist via explicit <code>RecordingStudio::RecordingStudioOrder</code> snapshots; actor resolution and RecordingStudioAccessible policy checks gate who can read or write those snapshots.</li>
        <li>Enable semantic event logging only when downstream audit/reporting needs addon-specific order events.</li>
      </ul>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Initializer example",
      subtitle: "Typical host app setup for optional order event settings.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <div>
      <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
        <div class="px-4 py-2 border-b border-(--code-block-border-color) text-sm font-medium text-(--code-block-title-color)">Code Example</div>
        <div class="p-4">
          <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">RecordingStudioOrderable.configure do |config|
  config.log_order_events = false
  config.event_action_prefix = "recording_order"
end</code></pre>
        </div>
      </div>
    </div>
  </div>
</div>