<div class="mx-auto flex w-full max-w-5xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_href: "javascript:window.history.back()",
    show_home: true,
    home_url: root_path,
    class: "mb-2"
  ) do |breadcrumb| %>
    <% breadcrumb.item(text: "Dummy app docs") %>
    <% breadcrumb.item(text: "Views") %>
  <% end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Views",
    subtitle: "Which pages are dummy-owned versus still served by the mounted addon.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <div>
      <%= render FlatPack::PageTitle::Component.new(
        title: "Mounted addon pages",
        subtitle: "Routes that still come from the engine mount.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>

      <div>
        <ul class="space-y-3 text-sm leading-6">
          <li><code>/recording_studio_orderable</code> for the addon home page.</li>
          <li><code>/recording_studio_orderable/recording_order_lists/new</code> for named-list creation.</li>
        </ul>
      </div>
    </div>

    <div>
      <%= render FlatPack::PageTitle::Component.new(
        title: "Dummy-owned docs pages",
        subtitle: "Documentation routes that now belong to the host app.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>

      <div>
        <ul class="space-y-3 text-sm leading-6">
          <li><code>/docs/setup</code> for installation and prerequisite guidance.</li>
          <li><code>/docs/config</code> for configuration guidance.</li>
          <li><code>/docs/methods</code> for public API summaries.</li>
          <li><code>/docs/views</code> for route ownership and UI notes.</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <div>
      <%= render FlatPack::PageTitle::Component.new(
        title: "Dummy routes example",
        subtitle: "Host app routing that serves the local docs pages.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>

      <div>
        <pre class="overflow-x-auto rounded-xl p-4 text-sm leading-6"><code>get "docs/config", to: "docs#configuration", as: :docs_config
get "docs/methods", to: "docs#methods_page", as: :docs_methods
get "docs/views", to: "docs#views_page", as: :docs_views</code></pre>
      </div>
    </div>

    <div>
      <%= render FlatPack::PageTitle::Component.new(
        title: "Sidebar integration",
        subtitle: "The dummy sidebar now links to local docs routes while keeping Setup mounted.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>

      <div>
        <pre class="overflow-x-auto rounded-xl p-4 text-sm leading-6"><code>&lt;%= render FlatPack::Sidebar::Item::Component.new(
  label: "Config",
  href: docs_config_path,
  icon: :cog_6_tooth
) %&gt;</code></pre>
      </div>
    </div>
  </div>
</div>