<div class="mx-auto flex w-full max-w-5xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_href: "javascript:window.history.back()",
    show_home: true,
    home_url: root_path,
    class: "mb-2"
  ) do |breadcrumb| %>
    <% breadcrumb.item(text: "Dummy app docs") %>
    <% breadcrumb.item(text: "Views") %>
  <% end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Views",
    subtitle: "Which pages are dummy-owned versus still served by the mounted addon.",
    variant: :h1
  ) %>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Mounted addon pages",
      subtitle: "Routes that still come from the engine mount.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <div>
      <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
        <div class="px-4 py-2 border-b border-(--code-block-border-color) text-sm font-medium text-(--code-block-title-color)">Code Example</div>
        <div class="p-4">
          <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">/recording_studio_orderable
/recording_studio_orderable/recording_studio_orders/new</code></pre>
        </div>
      </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Dummy-owned docs pages",
      subtitle: "Documentation routes that now belong to the host app.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <div>
      <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
        <div class="px-4 py-2 border-b border-(--code-block-border-color) text-sm font-medium text-(--code-block-title-color)">Code Example</div>
        <div class="p-4">
          <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">/docs/setup
/docs/config
/docs/methods
/docs/views</code></pre>
        </div>
      </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Dummy routes example",
      subtitle: "Host app routing that serves the local docs pages.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <div>
      <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
        <div class="px-4 py-2 border-b border-(--code-block-border-color) text-sm font-medium text-(--code-block-title-color)">Code Example</div>
        <div class="p-4">
          <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">get "docs/config", to: "docs#configuration", as: :docs_config
get "docs/methods", to: "docs#methods_page", as: :docs_methods
get "docs/views", to: "docs#views_page", as: :docs_views</code></pre>
        </div>
      </div>
    </div>
  </div>

  <div>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Sidebar integration",
      subtitle: "The dummy sidebar now links to local docs routes while keeping Setup mounted.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <div>
      <div class="mt-4 bg-(--code-block-background-color) border border-(--code-block-border-color) rounded-lg">
        <div class="px-4 py-2 border-b border-(--code-block-border-color) text-sm font-medium text-(--code-block-title-color)">Code Example</div>
        <div class="p-4">
          <pre class="whitespace-pre-wrap wrap-break-word"><code class="font-mono text-sm text-(--code-block-code-color)">&lt;%= render FlatPack::Sidebar::Item::Component.new(
  label: "Config",
  href: docs_config_path,
  icon: :cog_6_tooth
 ) %&gt;</code></pre>
        </div>
      </div>
    </div>
  </div>
</div>