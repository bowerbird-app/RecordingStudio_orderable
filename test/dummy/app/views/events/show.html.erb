<% content_for :title, "Events" %>
<% content_for :subtitle, "All Recording Studio events in the dummy app" %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: main_app.root_path,
  back_tooltip: "Home",
  anchor_href: main_app.root_path,
  anchor_tooltip: "Close"
) %>

<%= render FlatPack::Stack::Component.new(gap: :lg) do %>
  <%= render "home/demo_nav" %>

  <% if @events.empty? %>
    <%= render FlatPack::Alert::Component.new(description: "No events recorded yet.", style: :info) %>
  <% else %>
    <%= render FlatPack::Table::Component.new(data: @events, min_width: :none) do |table| %>
      <% table.column(title: "action", width: "7rem", wrap: :nowrap, html: ->(event) { event.action }) %>
      <% table.column(
           title: "item",
           width: "12rem",
           wrap: :nowrap,
           html: ->(event) { safe_join([event_recording_label(event), tag.br, event.recordable_type]) }
         ) %>
      <% table.column(title: "actor", width: "10rem", wrap: :nowrap, html: ->(event) { event_actor_label(event) }) %>
      <% table.column(
           title: "when",
           width: "8.5rem",
           wrap: :nowrap,
           html: ->(event) { render(FlatPack::Timestamp::Component.new(timestamp: event.occurred_at, tooltip_placement: :top)) }
         ) %>
      <% table.column(
           title: "metadata",
           html: lambda { |event|
             render(FlatPack::CodeBlock::Component.new(
               code: event_metadata(event),
               language: "json",
               title: "JSON",
               separated: false,
               class: "w-full max-w-full min-w-0"
             ))
           }
         ) %>
    <% end %>
  <% end %>
<% end %>
