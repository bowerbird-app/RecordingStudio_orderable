<% content_for :title, "Events" %>
<% content_for :subtitle, "All Recording Studio events in the dummy app" %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: main_app.root_path,
  back_tooltip: "Home",
  anchor_href: main_app.root_path,
  anchor_tooltip: "Close"
) %>

<div class="flex flex-col gap-8">
  <%= render "home/demo_nav" %>

  <% if @events.empty? %>
    <%= render FlatPack::Alert::Component.new(description: "No events recorded yet.", style: :info) %>
  <% else %>
    <%= render FlatPack::Table::Component.new(data: @events) do |table| %>
      <% table.column(title: "action", html: ->(event) { event.action }) %>
      <% table.column(
           title: "item",
           html: ->(event) { safe_join([event_recording_label(event), tag.br, event.recordable_type]) }
         ) %>
      <% table.column(title: "actor", html: ->(event) { event_actor_label(event) }) %>
      <% table.column(
           title: "when",
           html: lambda { |event|
             trigger_id = "event-occurred-at-#{event.id}"
             safe_join([
               button_tag("#{time_ago_in_words(event.occurred_at)} ago", id: trigger_id, type: "button"),
               render(
                 FlatPack::Popover::Component.new(trigger_id: trigger_id, placement: :top) do |popover|
                   popover.content { l(event.occurred_at, format: :long) }
                 end
               )
             ])
           }
         ) %>
      <% table.column(title: "metadata", html: ->(event) { tag.pre(event_metadata(event)) }) %>
    <% end %>
  <% end %>
</div>
