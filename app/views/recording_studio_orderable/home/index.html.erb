<% content_for :title, t("recording_studio.orderable.home.page_title", default: "Recording Studio Orderable") %>
<% content_for :subtitle, t("recording_studio.orderable.home.subtitle", default: "Opt in per recordable type. Sibling position lives on the child recording, not as a tree object.") %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  anchor_href: main_app.root_path,
  anchor_tooltip: t("recording_studio.orderable.home.page_nav_anchor_label", default: "Home")
) %>

<%= render FlatPack::Stack::Component.new(gap: :lg) do %>
  <%= render FlatPack::Card::Component.new(background: :default) do |card| %>
    <% card.body do %>
      <%= render FlatPack::Stack::Component.new(gap: :md) do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: t("recording_studio.orderable.home.body_before", default: "Enable ordering"),
          spacing: :none
        ) %>
        <%= render FlatPack::Text::Component.new(
          text: t(
            "recording_studio.orderable.home.body_after",
            default: "Add this on the parent type whose children should be sortable."
          )
        ) %>
        <%= render FlatPack::CodeBlock::Component.new(
          code: "include RecordingStudio::Capabilities::Orderable.to",
          language: "ruby",
          title: "Parent type",
          separated: false
        ) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
