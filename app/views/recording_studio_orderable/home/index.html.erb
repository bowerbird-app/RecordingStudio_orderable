<% recording_studio_page_nav(
  title: "Orderable",
  page_nav_anchor_url: main_app.root_path,
  page_nav_anchor_label: "Home"
) %>

<div class="flex flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording Studio Orderable",
    subtitle: "Opt in per recordable type. Sibling position lives on the child recording, not as a tree object.",
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <p>
        Host apps enable ordering with
        <code>include RecordingStudio::Capabilities::Orderable.to</code>
        on the parent type whose children should be sortable.
      </p>
    <% end %>
  <% end %>
</div>
