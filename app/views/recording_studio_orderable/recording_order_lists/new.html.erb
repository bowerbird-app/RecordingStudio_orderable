<div class="mx-auto flex w-full max-w-3xl flex-col px-6 py-12">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_href: "javascript:window.history.back()",
    class: "mb-2"
  ) do |breadcrumb| %>
  <% end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Create Custom Order",
    subtitle: "Create a custom order for #{@parent_recording_label}",
    variant: :h1
  ) %>

  <div>
    <%= form_with url: recording_studio_orders_path, scope: :recording_studio_order, class: "flex flex-col gap-4" do |form| %>
      <%= hidden_field_tag :parent_recording_id, @parent_recording.id %>
      <%= hidden_field_tag :group_key, @group_key %>
      <%= hidden_field_tag :redirect_to, @redirect_to if @redirect_to.present? %>
      <%= hidden_field_tag :source_order_recording_id, @source_order_recording_id if @source_order_recording_id.present? %>

      <div class="flex flex-col gap-2">
        <%= render FlatPack::TextInput::Component.new(
          name: "recording_studio_order[name]",
          label: "Order Name",
          required: true,
          placeholder: "My New Order",
          class: "!rounded-full"
        ) %>
      </div>

      <div class="flex items-center gap-3">
        <%= render FlatPack::Button::Component.new(
          text: "Create",
          style: :primary,
          size: :md,
          type: "submit",
          class: "!rounded-full"
        ) %>
      </div>
    <% end %>
  </div>
</div>