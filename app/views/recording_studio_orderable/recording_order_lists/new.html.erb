<div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_href: "javascript:window.history.back()",
    show_home: true,
    home_url: main_app.root_path,
    class: "mb-2"
  ) do |breadcrumb| %>
    <% breadcrumb.item(text: "Create ordered list") %>
  <% end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Create ordered list",
    subtitle: "Save a new order list for this recording.",
    variant: :h1
  ) %>

  <section class="flex flex-col gap-4">
    <%= form_with url: recording_order_lists_path, scope: :recording_order_list, class: "flex flex-col gap-4" do |form| %>
      <%= hidden_field_tag :parent_recording_id, @parent_recording.id %>
      <%= hidden_field_tag :group_key, @group_key %>
      <%= hidden_field_tag :redirect_to, @redirect_to if @redirect_to.present? %>
      <%= hidden_field_tag :source_order_recording_id, @source_order_recording_id if @source_order_recording_id.present? %>

      <div class="flex flex-col gap-2">
        <%= render FlatPack::TextInput::Component.new(
          name: "recording_order_list[name]",
          label: "List name",
          required: true,
          placeholder: "My saved list",
          class: "!rounded-full"
        ) %>
        <p class="text-xs text-(--surface-muted-content-color)">
          Parent <strong><%= @parent_recording_label %></strong>, group <strong><%= @group_key.to_s.humanize %></strong>
        </p>
        <p class="text-xs text-(--surface-muted-content-color)">
          Recording ID <code><%= @parent_recording.id %></code>
        </p>
      </div>

      <div class="flex items-center gap-3">
        <%= render FlatPack::Button::Component.new(
          text: "Create ordered list",
          style: :primary,
          size: :md,
          type: "submit",
          class: "!rounded-full"
        ) %>
      </div>
    <% end %>
  </section>
</div>