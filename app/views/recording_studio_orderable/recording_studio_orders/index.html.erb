<%= render FlatPack::Card::Component.new(
  style: :flat,
  theme: { background_muted: "transparent" },
  class: "mx-auto w-full max-w-5xl !bg-transparent !border-0 shadow-none"
) do |card| %>
  <% card.body do %>
    <%= render FlatPack::Breadcrumb::Component.new(
      class: "mb-2"
    ) do |breadcrumb| %>
      <% breadcrumb.item(
        text: "Back",
        href: "javascript:window.history.back()",
        icon: "chevron-left",
        class: "mr-3 text-slate-700 hover:text-slate-900"
      ) %>
    <% end %>

    <%= render FlatPack::PageTitle::Component.new(
      title: "Recording Studio Orders",
      subtitle: (@parent_recording_label.present? ? "Manage custom orders for #{@parent_recording_label}" : "Browse orderable types and their custom order counts."),
      variant: :h1
    ) %>

    <% if @type_rows.any? %>
      <%= render FlatPack::Table::Component.new(data: @type_rows) do |table| %>
        <% table.column(title: "Types", html: ->(row) { row.recordable_type }) %>
        <% table.column(title: "Custom Orders", html: ->(row) { row.custom_orders_count.to_s }) %>
        <% table.column(title: "Actions", html: ->(row) {
          parent_recording_id = row.parent_recording_id || @parent_recording&.id
          actions = []

          if parent_recording_id.present?
            actions << render(
              FlatPack::Button::Component.new(
                text: "View",
                style: :secondary,
                size: :sm,
                url: recording_studio_order_path(row.recordable_type, parent_recording_id: parent_recording_id)
              )
            )
          end

          if parent_recording_id.present? && row.group_key.present?
            actions << render(
              FlatPack::Button::Component.new(
                text: "Add",
                style: :primary,
                size: :sm,
                url: new_recording_studio_order_path(parent_recording_id: parent_recording_id, group_key: row.group_key)
              )
            )
          end

          safe_join(actions, " ")
        }) %>
      <% end %>
    <% else %>
      <%= render FlatPack::EmptyState::Component.new(
        title: "No orderable types found",
        description: "Orderable recording types appear here once they define order groups and have recordings."
      ) %>
    <% end %>
  <% end %>
<% end %>
