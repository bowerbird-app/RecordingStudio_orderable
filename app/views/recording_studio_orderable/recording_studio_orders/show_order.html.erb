<div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_href: recording_studio_order_path(@type_row.recordable_type, parent_recording_id: @parent_recording.id),
    class: "mb-2"
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: @order_display_name,
    subtitle: "Order details for #{@parent_recording_label}",
    variant: :h1
  ) %>

  <div class="flex flex-col gap-4">
    <div>
      <strong>Order Name:</strong> <%= @order_display_name %>
    </div>
    <div>
      <strong>Order ID:</strong> <%= @single_order.id %>
    </div>
    <div>
      <strong>Created At:</strong> <%= @single_order.created_at %>
    </div>
    <div>
      <strong>Updated At:</strong> <%= @single_order.updated_at %>
    </div>
    <!-- Add more order details as needed -->
  </div>

  <div class="flex items-center justify-end mt-6">
    <%= link_to "Edit", edit_recording_studio_order_path(@single_order.id, parent_recording_id: @parent_recording.id, group_key: @type_row.group_key, recordable_type: @type_row.recordable_type), class: "btn btn-primary" %>
  </div>
</div>
