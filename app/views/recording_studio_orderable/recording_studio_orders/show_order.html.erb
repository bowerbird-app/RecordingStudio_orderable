<div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_href: recording_studio_order_path(@type_row.recordable_type, parent_recording_id: @parent_recording.id),
    class: "mb-2"
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: @order_display_name,
    subtitle: "Order details for #{@parent_recording_label}",
    variant: :h1
  ) %>

  <% detail_rows = [
    { label: "Order Name", value: @order_display_name },
    { label: "Order ID", value: @single_order.id },
    { label: "Created At", value: @single_order.created_at },
    { label: "Updated At", value: @single_order.updated_at }
  ] %>

  <%= render FlatPack::Table::Component.new(data: detail_rows) do |table| %>
    <% table.column(title: "Field", html: ->(row) { row[:label] }) %>
    <% table.column(title: "Value", html: ->(row) { row[:value].to_s }) %>
  <% end %>

  <div class="flex items-center justify-end mt-6">
    <%= render FlatPack::Button::Component.new(
      text: "Edit",
      style: :primary,
      size: :md,
      url: edit_recording_studio_order_path(
        @single_order.id,
        parent_recording_id: @parent_recording.id,
        group_key: @type_row.group_key,
        recordable_type: @type_row.recordable_type
      )
    ) %>
  </div>
</div>
